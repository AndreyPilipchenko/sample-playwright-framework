{
  "name": "sample-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "playwright test",
    "test:local": "node scripts/app.mjs test",
    "app:up": "node scripts/app.mjs up",
    "app:down": "node scripts/app.mjs down",
    "app:status": "node scripts/app.mjs status",
    "app:logs": "node scripts/app.mjs logs",
    "postinstall": "node -e \"import('playwright-pom-harness/scripts/postinstall.mjs').catch(()=>{})\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.0",
    "allure": "3.19.1",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "dotenv": "17.4.2",
    "eslint-plugin-playwright": "2.12.2",
    "mssql": "12.7.2",
    "mysql2": "3.24.6",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.63.0",
    "playwright-ctrf-json-reporter": "0.0.29",
    "playwright-pom-harness": "file:.harness/vendor/playwright-pom-harness-4.3.2.tgz",
    "typescript": "7.0.2"
  }
}
